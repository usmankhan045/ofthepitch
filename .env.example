# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Note: no NEXT_PUBLIC_ prefix — nothing Supabase-related is exposed to the
# browser. All data access happens in Server Components, Server Actions and
# route handlers.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role bypasses RLS. This project is shared with other live sites and
# has no RLS policies, so tenant isolation depends entirely on every query
# filtering by site_id.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# The password you log in with.
ADMIN_PASSWORD=
# Signs the admin session cookie. REQUIRED and dedicated — it must NOT reuse
# ADMIN_API_TOKEN (that token is sent in Bearer headers proxies can log). Min 16
# chars; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this invalidates every existing session — use it to force a logout.
ADMIN_SESSION_SECRET=

# ── Admin REST API (/api/admin/*) ────────────────────────────────────────────
# Bearer token for programmatic access. Separate from the dashboard password so
# it can be rotated independently; never sent to the browser.
ADMIN_API_TOKEN=

# ── Cross-site revalidation ──────────────────────────────────────────────────
# Shared secret used when this site POSTs to another site's /api/revalidate.
REVALIDATION_SECRET=

# ── Pexels (stock photography) ───────────────────────────────────────────────
# Used by scripts/fetch-sport-images.mjs to download the category banner photos
# into public/images/sports. Server-side and build-time only, never exposed to
# the browser, so no NEXT_PUBLIC_ prefix. Free key from
# https://www.pexels.com/api/
PEXELS_API_KEY=
